{
  "name": "pi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "pi monorepo — the harness engine plus its web and tui clients, sharing one protocol package.",
  "scripts": {
    "dev": "pnpm --filter @pi/harness dev",
    "harness": "pnpm --filter @pi/harness dev",
    "web": "pnpm --filter @pi/web start",
    "tui": "pnpm --filter @pi/tui start",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@google/genai",
      "protobufjs"
    ]
  }
}
